{
	"schemaVersion": 1,
	"id": "aspenforest",
	"version": "${version}",
	"name": "Aspen Forest",
	"description": "Adds spreading aspen groves with interconnected root systems that grow naturally over time.",
	"authors": [
		"chrisdjmorgan"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/aspenforest/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.aspenforest.AspenForestMod"
		],
		"client": [
			"com.aspenforest.AspenForestModClient"
		],
		"fabric-datagen": [
			"com.aspenforest.datagen.AspenForestDataGenerator"
		]
	},
	"mixins": [
		"aspenforest.mixins.json",
		{
			"config": "aspenforest.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.0",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}